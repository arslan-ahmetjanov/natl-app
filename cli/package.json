{
  "name": "@natl/cli",
  "version": "1.0.0",
  "description": "NATL IDE · CLI для прогона YAML-сценариев в терминале и CI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "natl": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "brand",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "natl",
    "cli",
    "testing",
    "yaml",
    "e2e",
    "natl-ide",
    "test-automation"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --import tsx src/index.ts",
    "test": "node --import tsx --test src/flags.test.ts",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@natl/core": "^1.0.0"
  },
  "optionalDependencies": {
    "@natl/adapter-playwright": "^1.0.0",
    "@natl/adapter-selenium": "^1.0.0",
    "@natl/adapter-cypress": "^1.0.0"
  },
  "devDependencies": {
    "@natl/adapter-playwright": "^1.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natl-dev/natl.git",
    "directory": "cli"
  },
  "homepage": "https://arslan-ahmetjanov.github.io/natl-site/",
  "bugs": {
    "url": "https://github.com/arslan-ahmetjanov/natl-app/issues"
  }
}
